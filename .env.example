NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_FOURMEN_WHATSAPP=
NEXT_PUBLIC_SITE_URL=
# Comma-separated emails that get the admin panel. More can be added at /admin/team.
ADMIN_EMAILS=

# Email (resend.com). Without these, emails are skipped and a warning is logged.
RESEND_API_KEY=
EMAIL_FROM="Fourmen Events <hello@yourdomain.com>"
EMAIL_REPLY_TO=

# Protects the daily reveal job (/api/cron/reveal). Set the same value in Vercel.
CRON_SECRET=
